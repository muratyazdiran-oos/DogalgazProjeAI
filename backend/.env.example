NODE_ENV=production
GEMINI_API_KEY=your_key_here
PORT=8080
GEMINI_MODEL=gemini-3.8-flash
MAX_VIDEO_MB=500

# iOS istemcisi CORS'a tabi değildir. Web istemcisi eklerseniz virgülle ayırın.
ALLOWED_ORIGINS=

# Üretimde güçlü, rastgele bir token belirleyin ve aynı değeri uygulamanın AI Ayarları'na girin.
APP_API_TOKEN=

# Render/Fly/Cloud Run/Nginx gibi güvenilir tek proxy arkasındaysanız 1 yapın.
TRUST_PROXY=1

# Optional team accounts/cloud sync (use a long random secret)
TEAM_AUTH_SECRET=

# Production ekip/bulut için PostgreSQL zorunlu
DATABASE_URL=postgres://user:password@db:5432/dogalgaz
PGSSL=1
PGSSL_REJECT_UNAUTHORIZED=0

# Veritabanı yedekleri için scripts/backup-postgres.sh dosyasını cron/hosting scheduler ile çalıştırın.

# Artifact storage: boşsa ARTIFACT_STORAGE_DIR kullanılır.
# Cloudflare R2 / AWS S3 / MinIO uyumludur.
S3_ARTIFACT_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0
ARTIFACT_STORAGE_DIR=/data/dogalgaz-artifacts

# AR video / depth / saha kanıtı artifact üst limiti (25-4096 MB)
MAX_ARTIFACT_MB=1024
# Presigned S3/R2 upload kullanıyorsanız bucket CORS politikası PUT, GET, HEAD
# ve Content-Type / x-amz-meta-* header'larına izin vermelidir.
