NODE_ENV=production
GEMINI_API_KEY=your_key_here
PORT=8080
GEMINI_MODEL=gemini-3.8-flash
MAX_VIDEO_MB=500

# iOS istemcisi CORS'a tabi değildir. Web istemcisi eklerseniz virgülle ayırın.
ALLOWED_ORIGINS=

# Üretimde güçlü, rastgele bir token belirleyin ve aynı değeri uygulamanın AI Ayarları'na girin.
APP_API_TOKEN=

# Render/Fly/Cloud Run/Nginx gibi güvenilir tek proxy arkasındaysanız 1 yapın.
TRUST_PROXY=1

# Optional team accounts/cloud sync (use a long random secret)
TEAM_AUTH_SECRET=

# Production ekip/bulut için PostgreSQL zorunlu
DATABASE_URL=postgres://user:password@db:5432/dogalgaz
PGSSL=1
PGSSL_REJECT_UNAUTHORIZED=0

# Veritabanı yedekleri için scripts/backup-postgres.sh dosyasını cron/hosting scheduler ile çalıştırın.
